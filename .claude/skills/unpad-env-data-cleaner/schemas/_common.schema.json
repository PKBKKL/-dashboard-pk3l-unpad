{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_common.schema.json",
  "definitions": {
    "iso_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "iso_month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "version_str": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "data_quality_flag": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/definitions/iso_date" },
        "end": { "$ref": "#/definitions/iso_date" }
      }
    },
    "dataset_envelope": {
      "type": "object",
      "required": ["dataset_id", "version", "generated_at", "source_files", "period", "data_quality_flags"],
      "properties": {
        "dataset_id": { "type": "string" },
        "version": { "$ref": "#/definitions/version_str" },
        "generated_at": { "type": "string" },
        "source_files": { "type": "array", "items": { "type": "string" } },
        "period": { "$ref": "#/definitions/period" },
        "data_quality_flags": {
          "type": "array",
          "items": { "$ref": "#/definitions/data_quality_flag" }
        }
      }
    },
    "threshold": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "max"],
          "properties": { "type": { "const": "max" }, "max": { "type": "number" } }
        },
        {
          "type": "object",
          "required": ["type", "min"],
          "properties": { "type": { "const": "min" }, "min": { "type": "number" } }
        },
        {
          "type": "object",
          "required": ["type", "min", "max"],
          "properties": { "type": { "const": "range" }, "min": { "type": "number" }, "max": { "type": "number" } }
        },
        {
          "type": "object",
          "required": ["type", "max_dev"],
          "properties": { "type": { "const": "deviation" }, "max_dev": { "type": "number" }, "reference": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "qualitative" }, "expected": { "type": "string" } }
        }
      ]
    }
  }
}
