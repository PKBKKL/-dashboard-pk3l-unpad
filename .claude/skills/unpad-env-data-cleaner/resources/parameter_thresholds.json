{
  "version": "1.0",
  "comment": "Maps water-quality parameters to their threshold direction. Lab certificates use '^' for any deviation, but DO is actually a minimum, not a maximum. This file is the source of truth for threshold direction.",
  "parameters": {
    "suhu": { "label": "Suhu", "unit": "°C", "category": "fisika" },
    "dhl": { "label": "Daya Hantar Listrik (DHL)", "unit": "µmhos/cm", "category": "fisika", "no_threshold": true },
    "tss": { "label": "Padatan Tersuspensi Total (TSS)", "unit": "mg/L", "category": "fisika", "direction": "max" },
    "tds": { "label": "Padatan Terlarut Total (TDS)", "unit": "mg/L", "category": "fisika", "direction": "max" },
    "kekeruhan": { "label": "Kekeruhan", "unit": "NTU", "category": "fisika", "direction": "max" },
    "warna": { "label": "Warna", "unit": "TCU", "category": "fisika", "direction": "max" },
    "bau": { "label": "Bau", "unit": null, "category": "fisika", "direction": "qualitative" },
    "ph": { "label": "pH", "unit": null, "category": "kimia", "direction": "range" },
    "kesadahan": { "label": "Kesadahan (CaCO₃)", "unit": "mg/L", "category": "kimia", "no_threshold": true },
    "klorida": { "label": "Klorida", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "fe": { "label": "Besi (Fe)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "mn": { "label": "Mangan (Mn)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "ni": { "label": "Nikel (Ni)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "zn": { "label": "Seng (Zn)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "cu": { "label": "Tembaga (Cu)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "cr_total": { "label": "Krom Total (Cr)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "cr6": { "label": "Krom Heksavalen (Cr⁶⁺)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "cd": { "label": "Kadmium (Cd)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "pb": { "label": "Timbal (Pb)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "bod": { "label": "BOD", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "cod": { "label": "COD", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "do": { "label": "Oksigen Terlarut (DO)", "unit": "mg/L", "category": "kimia", "direction": "min", "compliance_note": "DO baku mutu adalah minimum; nilai ≥ baku mutu menunjukkan kualitas oksigen baik. LHU memberi tanda '^' pada parameter ini meski compliant."},
    "tn": { "label": "Total Nitrogen", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "no3_n": { "label": "Nitrat sebagai N (NO₃-N)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "no2_n": { "label": "Nitrit sebagai N (NO₂-N)", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "po4": { "label": "Orto Fosfat (PO₄³⁻)", "unit": "mg/L", "category": "kimia", "no_threshold": true },
    "minyak_lemak": { "label": "Minyak dan Lemak", "unit": "mg/L", "category": "kimia", "direction": "max" },
    "mpn_ecoli": { "label": "MPN E. coli", "unit": "JPT/100ml", "category": "biologi", "direction": "max" },
    "mpn_coliform": { "label": "MPN Coliform", "unit": "JPT/100ml", "category": "biologi", "direction": "max" },
    "ecoli_cfu": { "label": "E. coli", "unit": "CFU/100ml", "category": "mikrobiologi", "direction": "max" },
    "coliform_cfu": { "label": "Total Coliform", "unit": "CFU/100ml", "category": "mikrobiologi", "direction": "max" }
  }
}
